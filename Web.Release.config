<?xml version="1.0" encoding="utf-8"?>

<!-- For more information on using web.config transformation visit https://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Local dev reads secrets from Web.AppSecrets.config / Web.ConnectionStrings.config via
    configSource - those two files are gitignored and never get published. This Release
    transform swaps in plain inline sections (with harmless placeholder values) so the deployed
    Web.config is self-contained, valid XML with no missing configSource file. The REAL secret
    values live only in the Azure App Service "Configuration" blade (Application settings +
    Connection strings), which overrides these placeholders at runtime - the actual passwords
    never sit in a file on the server or in source control.
  -->
  <appSettings xdt:Transform="Replace">
    <add key="SmtpHost" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUser" value="set-in-azure-configuration" />
    <add key="SmtpPassword" value="set-in-azure-configuration" />
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <connectionStrings xdt:Transform="Replace">
    <add name="MongoConnection" connectionString="set-in-azure-configuration" />
  </connectionStrings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
</configuration>
